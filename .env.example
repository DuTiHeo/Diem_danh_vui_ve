# DATABASE
POSTGRES_USER=neu_admin
POSTGRES_PASSWORD=neu_password
POSTGRES_DB=neu_attendance
DATABASE_URL=postgresql+asyncpg://neu_admin:neu_password@localhost:5432/neu_attendance

# AUTHENTICATION
JWT_SECRET=supersecretkey_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MICROSOFT ENTRA ID OAUTH2
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# DEV MODE
DEV_MOCK_AUTH=true

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:8000

